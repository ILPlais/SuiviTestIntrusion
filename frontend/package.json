{
	"name": "suivi-test-intrusion-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "node scripts/copy-swagger-ui.mjs && vue-tsc -b && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "vue-tsc --build",
		"test:e2e": "playwright test",
		"test:e2e:production": "playwright test --config playwright.production.config.ts"
	},
	"dependencies": {
		"@webtui/css": "0.1.10",
		"@webtui/theme-catppuccin": "0.0.5",
		"@zxcvbn-ts/core": "^4.3.0",
		"@zxcvbn-ts/language-common": "^4.2.0",
		"argon2id": "^1.0.1",
		"dompurify": "^3.4.18",
		"marked": "^18.2.1",
		"pinia": "^4.1.0",
		"qrcode": "^1.5.4",
		"swagger-ui-dist": "^5.35.1",
		"vue": "^3.5.44",
		"vue-i18n": "^11.4.23",
		"vue-router": "^5.5.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/test-utils": "^2.6.0",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.15.0",
		"eslint-plugin-jsdoc": "^65.5.2",
		"eslint-plugin-vue": "^10.12.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.1",
		"vue-tsc": "^3.3.14"
	}
}
