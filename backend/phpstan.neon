# Analyse statique du back-end (socle-3) : Larastan, niveau 6.
# Lancer : composer analyse
includes:
	- vendor/larastan/larastan/extension.neon

parameters:
	level: 6
	paths:
		- app
		- bootstrap/app.php
		- config
		- database
		- routes
		- tests
	# Fixture de la règle des DocBlocks : ses manques sont volontaires.
	excludePaths:
		- tests/PHPStan/Fixtures

# Règle du projet (21.01) : DocBlock décrit et typé sur chaque élément PHP.
rules:
	- Tests\PHPStan\RequireTypedDocBlockRule
