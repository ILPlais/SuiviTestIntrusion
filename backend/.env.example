APP_NAME=SuiviTestIntrusion
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données : sqlite (par défaut), mysql, mariadb ou pgsql.
# SQLite : fichier database/database.sqlite, aucun autre réglage.
DB_CONNECTION=sqlite

# MySQL :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=suivi_test_intrusion
# DB_USERNAME=suivi
# DB_PASSWORD=

# MariaDB :
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=suivi_test_intrusion
# DB_USERNAME=suivi
# DB_PASSWORD=

# PostgreSQL :
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=suivi_test_intrusion
# DB_USERNAME=suivi
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pagination par défaut des listes de l'API : cursor (recommandé) ou page.
API_PAGINATION=cursor

# Proxys inverses de confiance (13.06) : adresses ou réseaux CIDR séparés par des
# virgules, seuls autorisés à transmettre X-Forwarded-*. Vide : aucun ; « * », REMOTE_ADDR et /0 sont refusés.
TRUSTED_PROXIES=

# Limites de débit de l'API (11.03, socle-5) : requêtes par minute par classe,
# requêtes simultanées par utilisateur, attente maximale après blocages répétés
# de la connexion (secondes), taille maximale d'un corps JSON (octets).
API_RATE_STANDARD=60
API_RATE_HEAVY=20
API_RATE_EXPORT=5
API_RATE_AUTH=10
API_CONCURRENT_HEAVY=1
API_CONCURRENT_EXPORT=2
API_AUTH_MAX_LOCKOUT=3600
API_MAX_JSON_SIZE=2097152
