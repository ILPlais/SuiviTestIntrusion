# Style commun à tous les éditeurs (21.01, « Style du code »).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Formats qui imposent des espaces.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
trim_trailing_whitespace = false

# Fichiers générés par les gestionnaires de paquets.
[{package-lock.json,composer.lock}]
indent_style = space
indent_size = 2
