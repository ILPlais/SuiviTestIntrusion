# Exemple de proxy inverse Caddy devant SuiviTestIntrusion (socle-2, 13.06).
#
# Caddy obtient et renouvelle le certificat, redirige HTTP vers HTTPS et transmet
# X-Forwarded-For, -Proto et -Host. TLS 1.2 au minimum, 1.3 privilégié. Déclarer
# l'adresse d'où Caddy se connecte dans TRUSTED_PROXIES.

pentest.example.org {
	tls {
		protocols tls1.2 tls1.3
	}

	# Envoi d'une preuve chiffrée : 100 Mio de fichier plus le surcoût.
	request_body {
		max_size 110MiB
	}

	reverse_proxy 127.0.0.1:8080
}
