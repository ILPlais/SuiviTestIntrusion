# Configuration de l'instance Docker (socle-2) : copier en docker/.env, puis compléter.
# Ce fichier sert à la fois à Compose (variables ${...} de compose.yaml) et aux
# conteneurs app, queue et scheduler. Procédure complète : 42.01.

APP_NAME=SuiviTestIntrusion
APP_ENV=production
APP_DEBUG=false
# Clé de chiffrement de Laravel (sessions, cookies) : à générer une fois et à conserver.
#   docker compose --file docker/compose.yaml run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
# Adresse publique, en HTTPS, servie par le proxy inverse.
APP_URL=https://pentest.example.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Proxy inverse de confiance (13.06) : la passerelle du réseau interne (DOCKER_SUBNET,
# adresse .1) quand le proxy tourne sur l'hôte ; jamais « * ».
TRUSTED_PROXIES=172.31.250.1

# Exposition du conteneur app : HTTP sur l'hôte seulement, pour le proxy.
APP_BIND=127.0.0.1
APP_PORT=8080
DOCKER_SUBNET=172.31.250.0/24

# Journaux sur la sortie des conteneurs (docker compose logs).
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Base SQLite par défaut, dans le volume des données ; attente et journal WAL, car
# app, queue et scheduler écrivent en même temps.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal

# PostgreSQL intégrée (profil database) : remplacer le bloc SQLite par celui-ci.
# DB_CONNECTION=pgsql
# DB_HOST=database
# DB_PORT=5432
# DB_DATABASE=suivi
# DB_USERNAME=suivi
# DB_PASSWORD=mot-de-passe-long-et-aléatoire

# Base externe (MySQL, MariaDB ou PostgreSQL de l'exploitant) : mêmes variables,
# avec DB_HOST pointant vers le serveur.

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Aucun e-mail en V1 (13.06).
MAIL_MAILER=log

API_PAGINATION=cursor
