{
  "showLineNumber": true,
  "tabSize": 2,
  "userIgnoreFilters": [
    "node_modules/",
    "vendor/",
    "backend/storage/",
    "frontend/dist/",
    "__dotfile_preview__"
  ],
  "showUnsupportedFiles": true,
  "pdfExportSettings": {
    "pageSize": "A4",
    "landscape": false,
    "margin": "0",
    "downscalePercent": 80
  },
  "defaultViewMode": "preview",
  "showInlineTitle": false
}